# --- Branding ---
SHOP_NAME=Byteflix
SHOP_DISCORD_URL=

# --- Feature switches ---
# Checkout tabs/fields are hidden AND the API rejects redeems while disabled.
AZTECO_ENABLED=false
PLEX_ENABLED=false

# --- Network binding ---
# 0.0.0.0 exposes web (3000) and api (4000) publicly; set 127.0.0.1 once a
# reverse proxy on this host terminates TLS.
BIND_HOST=0.0.0.0

# --- Datastores ---
# Required: password for the bundled Postgres (compose refuses to start without it).
# NOTE: an existing postgres volume keeps the password of its FIRST initialization —
# enter that value here, not a new one.
POSTGRES_PASSWORD=

# --- Admin panel (/admin) ---
# All three required before the panel accepts logins. Generate the secret e.g.
# with: openssl rand -hex 32 — then enable TOTP 2FA inside the panel.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Discord bot ---
# Shared Bearer secret for the bot's write endpoints (heartbeat/report/ack).
# Empty = bot write endpoints disabled.
BOT_API_SECRET=

# --- NOWPayments ---
# Production: both values are required (config refuses to start with a key but no IPN secret).
# Sandbox testing: NOWPAYMENTS_BASE_URL=https://api-sandbox.nowpayments.io/v1 with a key/secret
#   from https://account-sandbox.nowpayments.io (drive outcomes via the sandbox-only `case` field).
# Local mock mode: leave NOWPAYMENTS_API_KEY empty — invoices become /pay/mock-invoice/... pages.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# --- Azteco ---
AZTECO_CLIENT_MODE=mock
AZTECO_RESELLER_API_BASE=
AZTECO_RESELLER_API_KEY=

# --- jfa-go (backend-only: customers never see its UI) ---
# jfa-go runs as its OWN container on this host (not part of this stack);
# the API reaches it through the host gateway. No long-lived API keys exist:
# the portal logs in with admin credentials (JFA_GO_USER is accepted as a
# legacy alias for JFA_GO_USERNAME).
JFA_GO_BASE_URL=http://host.docker.internal:8056
JFA_GO_USERNAME=
JFA_GO_PASSWORD=
JFA_GO_DEFAULT_PROFILE=

# --- Jellyfin ---
# When set, user-existence checks prefer the Jellyfin API over jfa-go.
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=
# Customer-facing Jellyfin URL — shown as "log in now" after registration.
JELLYFIN_PUBLIC_URL=

# --- Plex (yearly plan perk; UI hidden while PLEX_ENABLED=false) ---
PLEX_TOKEN=
PLEX_SERVER_NAME=

# --- URLs ---
PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:4000

# --- Local development outside Docker ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_portal
REDIS_URL=redis://localhost:6379
