# --- Branding ---
SHOP_NAME=Byteflix
SHOP_DISCORD_URL=

# --- Datastores ---
# Required: strong random password for the bundled Postgres (compose refuses to start without it).
POSTGRES_PASSWORD=

# --- NOWPayments ---
# Production: both values are required (config refuses to start with a key but no IPN secret).
# Sandbox testing: NOWPAYMENTS_BASE_URL=https://api-sandbox.nowpayments.io/v1 with a key/secret
#   from https://account-sandbox.nowpayments.io (drive outcomes via the sandbox-only `case` field).
# Local mock mode: leave NOWPAYMENTS_API_KEY empty — invoices become /pay/mock-invoice/... pages.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# --- Azteco ---
AZTECO_CLIENT_MODE=mock
AZTECO_RESELLER_API_BASE=
AZTECO_RESELLER_API_KEY=

# --- jfa-go ---
# jfa-go has no long-lived API keys: its JWTs expire after 20 minutes and the signing
# secret rotates on restart. The portal therefore logs in with admin credentials
# (the [ui] user from jfa-go's config, or a Jellyfin admin account).
JFA_GO_BASE_URL=http://jfa-go:8056
JFA_GO_USERNAME=
JFA_GO_PASSWORD=
# Public URL of the jfa-go instance (reverse-proxied) — used to build customer invite links.
JFA_GO_EXTERNAL_URL=
JFA_GO_DEFAULT_PROFILE=
INVITE_VALIDITY_DAYS=7

# --- Jellyfin (reserved for direct integrations) ---
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=

# --- Plex (yearly plan / €100 voucher perk) ---
PLEX_TOKEN=
PLEX_SERVER_NAME=

# --- URLs ---
PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:4000

# --- Local development outside Docker ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_portal
REDIS_URL=redis://localhost:6379
