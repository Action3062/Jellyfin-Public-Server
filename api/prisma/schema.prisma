generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Provider {
  nowpayments
  azteco
  manual
}

enum SubscriptionStatus {
  active
  pending
  failed
  expired
}

model User {
  id                String         @id @default(cuid())
  jellyfinUsername  String         @unique
  jellyfinUserId    String?
  plexUsername      String?
  createdAt         DateTime       @default(now())
  subscriptions     Subscription[]
}

model Plan {
  id        String   @id
  product   String
  label     String
  priceEur  Decimal  @map("price_eur") @db.Decimal(10, 2)
  months    Int
  popular   Boolean  @default(false)
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
}

model AztecoOption {
  id      String  @id @default(cuid())
  product String
  eur     Decimal @db.Decimal(10, 2)
  days    Int

  @@unique([product, eur])
}

model Payment {
  id          String   @id @default(cuid())
  provider    Provider
  providerRef String?  @map("provider_ref")
  orderId     String   @unique @map("order_id")
  coin        String?
  amountEur   Decimal  @map("amount_eur") @db.Decimal(10, 2)
  status      String
  user        String
  product     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model VoucherRedemption {
  id        String   @id @default(cuid())
  codeHash  String   @unique @map("code_hash")
  status    String
  valueEur  Decimal  @default(0) @map("value_eur") @db.Decimal(10, 2)
  txRef     String?  @map("tx_ref")
  user      String
  product   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id])
  plan      String
  source    Provider
  startsAt  DateTime           @map("starts_at")
  expiresAt DateTime           @map("expires_at")
  status    SubscriptionStatus
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")
}

// Security/audit trail for the admin panel: every login (success + failure),
// trial toggle, manual credit, and user enable/disable is recorded here.
model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  actor     String   @default("")
  ip        String   @default("")
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
}

// Weekly funnel history pushed by the Discord bot (one row per guild per report
// period) so the admin panel can chart trial->abo conversion over time.
model FunnelSnapshot {
  id            String   @id @default(cuid())
  guildId       String   @map("guild_id")
  trials        Int      @default(0)
  upgrades      Int      @default(0)
  expired       Int      @default(0)
  reactivated   Int      @default(0)
  activeAbos    Int      @default(0) @map("active_abos")
  activeTrials  Int      @default(0) @map("active_trials")
  periodEnd     DateTime @map("period_end")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([guildId, periodEnd])
}

// Latest snapshot the bot pushes for a given kind ("trials", "tickets"). The
// panel reads the most recent blob instead of talking to the bot directly.
model BotReport {
  kind      String   @id
  payload   Json
  updatedAt DateTime @updatedAt @map("updated_at")
}

// Command queue the bot polls (e.g. reset a user's trial). The admin enqueues a
// command; the bot marks it done/failed on its next poll.
model BotCommand {
  id          String    @id @default(cuid())
  kind        String
  target      String
  status      String    @default("pending")
  result      String?
  createdBy   String    @default("") @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    Provider
  eventId     String    @map("event_id")
  payload     Json
  processedAt DateTime? @map("processed_at")

  @@unique([provider, eventId])
}
